rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'm462556532@gmail.com';
    }
  }
}
